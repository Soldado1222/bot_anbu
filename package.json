{
  "name": "discord-bot-communautaire",
  "version": "1.0.0",
  "description": "Bot Discord moderne avec commandes slash pour serveur communautaire",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "deploy-prod": "npm run build && node dist/deploy-commands.js",
    "watch": "tsc -w"
  },
  "keywords": ["discord", "bot", "slash-commands"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
